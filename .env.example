# Lovable auto-injects these at build time — do NOT commit a real .env.
# This file is the template; copy to .env locally if you need overrides
# and ensure .env is gitignored.

VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Product analytics + error monitoring (frontend). All optional — SDKs no-op
# gracefully when missing so preview builds without keys still work.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT=""
VITE_APP_RELEASE=""

# Server-only (never put service-role keys here in production):
# SUPABASE_URL="..."
# SUPABASE_PUBLISHABLE_KEY="..."
# MEAL_PLAN_REGENERATION_LIMIT_ENABLED="true"  # set to "false" temporarily to bypass meal-plan generation limits during testing
# STARTER_PANTRY_SEED_ENABLED="false"          # set to "true" to let signed-in users add starter pantry/fridge/freezer items
# SENTRY_DSN="..."             # separate DSN for edge-function errors
# POSTHOG_API_KEY=""           # optional, only if you do server-side capture
# POSTHOG_HOST=""
